{
  "name": "@yulaiz/dsh-widthkeeper",
  "version": "0.2.3",
  "description": "DeepSeek Harness 的会话宽度插件，支持 Web 版和桌面版。拖动滑杆或输入像素值即可固定主会话的正文宽度，隐藏控件后仍会保留宽度设置。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "conversation-width",
    "chat-width",
    "content-width"
  ],
  "license": "MIT",
  "author": "YuLaiZ (https://github.com/YuLaiZ)",
  "contributors": [
    "jinngoo <jinngoo@qq.com> (https://github.com/Jinngoo)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuLaiZ/dsh-widthkeeper.git"
  },
  "homepage": "https://github.com/YuLaiZ/dsh-widthkeeper#readme",
  "bugs": {
    "url": "https://github.com/YuLaiZ/dsh-widthkeeper/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "src/index.js",
  "icon": "./icon.png",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./client": {
      "default": "./src/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.png",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1"
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/client.js",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
