{
  "name": "dsh-widthkeeper",
  "version": "0.1.0",
  "description": "会话内容列的守宽人：滑杆、精确输入、自动读值，钉住宽度后收起控件（DSH Web UI 插件）。Fork of @jinngoo/dsh-conversation-width.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "web-ui",
    "layout",
    "width"
  ],
  "license": "MIT",
  "author": "YuLaiZ (https://github.com/YuLaiZ)",
  "contributors": [
    "jinngoo <jinngoo@qq.com> (https://github.com/Jinngoo)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuLaiZ/dsh-widthkeeper.git"
  },
  "homepage": "https://github.com/YuLaiZ/dsh-widthkeeper#readme",
  "bugs": {
    "url": "https://github.com/YuLaiZ/dsh-widthkeeper/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
