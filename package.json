{
  "name": "@yulaiz/dsh-widthkeeper",
  "version": "0.2.0",
  "description": "会话内容列的守宽人：滑杆、精确输入、自动读值，钉住宽度后可收起控件（DSH Web UI 插件）。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "web-ui",
    "layout",
    "width"
  ],
  "license": "MIT",
  "author": "YuLaiZ (https://github.com/YuLaiZ)",
  "contributors": [
    "jinngoo <jinngoo@qq.com> (https://github.com/Jinngoo)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuLaiZ/dsh-widthkeeper.git"
  },
  "homepage": "https://github.com/YuLaiZ/dsh-widthkeeper#readme",
  "bugs": {
    "url": "https://github.com/YuLaiZ/dsh-widthkeeper/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./client": {
      "default": "./src/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
